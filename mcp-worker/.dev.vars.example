# Local development only (`npm run dev`). Copy to .dev.vars, which is gitignored.
GITHUB_CLIENT_ID=<your github client id>
GITHUB_CLIENT_SECRET=<your github client secret>
COOKIE_ENCRYPTION_KEY=<openssl rand -hex 32>
PB_URL=https://<nas>.<tailnet>.ts.net
PB_EMAIL=<pocketbase superuser email>
PB_PASSWORD=<pocketbase superuser password>
TIDAL_CLIENT_ID=<client id from developer.tidal.com>
