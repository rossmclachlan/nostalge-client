# Copy to .env (gitignored) and fill in. Never commit .env.

# --- PocketBase service user (create in the PocketBase admin UI: users collection) ---
PB_EMAIL=mcp@nostalge.local
PB_PASSWORD=
# Set by docker-compose.yml; only needed when running outside Docker:
# PB_URL=http://192.168.68.52:8095

# Docker network of the music-cms-mvp stack (see `docker network ls`)
PB_DOCKER_NETWORK=music-cms_default

# --- Public URL Claude connects to, no trailing slash ---
# Default: your Tailscale Funnel hostname, e.g. https://nas-machine-name.tailnet-name.ts.net
# (run `tailscale funnel --bg 8765` on the NAS). Using Cloudflare Tunnel instead? Use that hostname.
PUBLIC_BASE_URL=https://nas-machine-name.tailnet-name.ts.net

# --- OAuth: the one client Claude uses. Paste both into the connector's Advanced settings. ---
OAUTH_CLIENT_ID=nostalge-claude
# openssl rand -hex 32
OAUTH_CLIENT_SECRET=
# The password you type on the consent page when connecting Claude (12+ characters)
OWNER_PASSWORD=
# Extra allowed redirect URIs, comma-separated (e.g. MCP Inspector for local testing):
# OAUTH_EXTRA_REDIRECT_URIS=http://localhost:6274/oauth/callback
OAUTH_EXTRA_REDIRECT_URIS=

# --- Matching ---
MATCH_MIN_CONFIDENCE=0.80
# Look up ISRCs on MusicBrainz from track MBIDs (1 request/second; cached matches skip it)
MUSICBRAINZ_LOOKUP=true
MUSICBRAINZ_CONTACT=https://github.com/rossmclachlan/nostalge-client

# --- Optional alternative to Tailscale Funnel: Cloudflare Tunnel token, for
# `docker compose --profile tunnel up -d` (see README) ---
CLOUDFLARE_TUNNEL_TOKEN=
